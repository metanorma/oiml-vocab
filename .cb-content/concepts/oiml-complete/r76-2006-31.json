      ],
      "definitions": [
        {
          "content": "If no particular working temperature is stated in the descriptive markings of an instrument, this instrument shall maintain its metrological properties within the following temperature limits:\n\n$$\n- 1 0 ^ {\\circ} \\mathrm {C} / + 4 0 ^ {\\circ} \\mathrm {C}\n$$"
        }
      ],
