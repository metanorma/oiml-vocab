    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "reduction ratio, R",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "The reduction ratio of a load transmitting device is: R = F_M / F_L"
        },
        {
          "content": "where: F_M = force acting on the load measuring device, F_L = force acting on the load receptor."
        }
      ],
      "notes": [],
      "examples": []
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "rapport de réduction, R",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "Le rapport de réduction d'un dispositif transmetteur de charge est égal à : R = F_M / F_L"
        },
        {
          "content": "où : F_M = force agissant sur le dispositif mesureur de charge, F_L = force agissant sur le récepteur de charge."
        }
      ],
      "notes": [],
      "examples": []
    }
  },
