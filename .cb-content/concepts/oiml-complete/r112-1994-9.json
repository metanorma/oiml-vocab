      ],
      "definitions": [
        {
          "content": "The concentration of the sample component of interest that gives a detector output signal equal to three times the short-term noise."
        }
      ],
      "notes": [
        {
          "content": "This term is also referred to as \"minimum detectability\" in some references and manufacturer's literature."
        }
      ],
      "examples": []
    },
    "fra": {
