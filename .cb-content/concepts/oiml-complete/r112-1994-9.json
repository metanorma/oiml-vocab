      "terms": [
        {
          "designation": "Limite de détection de l'instrument",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "Concentration d'un composant de l'échantillon examiné provoquant un signal de sortie du détecteur égal à trois fois le niveau du bruit à court terme."
        }
      ],
      "notes": [],
      "examples": []
    }
