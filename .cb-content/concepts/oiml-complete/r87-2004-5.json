    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "T1 error",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "An inadequate prepackage found to contain an actual quantity less than the nominal quantity minus the tolerable deficiency allowed in 4.2.3 for the nominal quantity is called a T1 error."
        },
        {
          "content": "T1 error: Actual contents < (Q_n - T)"
        }
      ],
      "notes": [],
      "examples": []
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "Erreur T1",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "Un préemballage inadéquat pour lequel il est constaté que la quantité réelle contenue est inférieure à la quantité nominale moins l'insuffisance tolérée autorisée en 4.2.3 pour la quantité nominale, est désigné comme erreur T1."
        },
        {
          "content": "Erreur T1: Contenu réel < (Q_n - T)"
        }
      ],
      "notes": [],
      "examples": []
    }
  },
