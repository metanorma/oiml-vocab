      ],
      "definitions": [
        {
          "content": "Véhicules ayant une valeur conventionnellement vraie connue (T.1.9) de :"
        },
        {
          "content": "- masse, et charge par essieu simple pour un véhicule rigide à deux essieux ; et"
        },
        {
          "content": "- masse pour les autres véhicules utilisés pour les essais en mouvement (6.5),"
        },
        {
