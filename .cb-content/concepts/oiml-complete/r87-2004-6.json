  "localizations": {
    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "T2 error",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "An inadequate prepackage found to contain an actual quantity less than the nominal quantity minus twice the tolerable deficiency for a nominal quantity allowed in 4.2.3 is called a T2 error."
        },
        {
          "content": "T2 error: Actual contents < (Q_n - T 2)"
        }
      ],
      "notes": [],
      "examples": []
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "Erreur T2",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "Un préemballage inadéquat pour lequel il est constaté que la quantité réelle contenue est inférieure à la quantité nominale moins deux fois l'insuffisance tolérée autorisée en 4.2.3 pour la quantité nominale, est désigné comme erreur T2."
        },
        {
          "content": "Erreur T2: Contenu réel < (Q_n - T 2)"
        }
      ],
      "notes": [],
      "examples": []
    }
  },
