  "designations": {
    "eng": "repeatability error",
    "fra": "erreur de répétabilité"
  },
  "eng": "repeatability error",
  "groups": [
    "r-134"
  ],
  "tags": [],
  "localizations": {
    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "repeatability error",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "Difference between the highest and lowest results of successive measurements of the same load carried out under the same conditions of measurement."
        }
      ],
      "notes": [
        {
          "content": "Repeatability conditions include:"
        },
        {
          "content": "- the same measurement procedure;"
        },
        {
          "content": "- the same operator;"
        },
        {
          "content": "- the same measuring instrument, used under the same conditions;"
        },
        {
          "content": "- the same location;"
        },
        {
          "content": "- repetition over a short period of time."
        }
      ],
      "examples": []
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "erreur de répétabilité",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "Différence entre le résultat le plus grand et le résultat le plus faible de mesures successives de la même charge réalisées dans les mêmes conditions de mesure."
        }
      ],
      "notes": [
        {
          "content": "Les conditions de répétabilité incluent :"
        },
        {
          "content": "- la même procédure de mesure ;"
        },
        {
          "content": "- le même opérateur ;"
        },
        {
          "content": "- le même instrument de mesure, utilisé dans les mêmes conditions ;"
        },
        {
          "content": "- le même lieu ;"
        },
        {
          "content": "- une répétition sur une courte durée."
        }
      ],
      "examples": []
    }
  },
  "languages": [
    "eng",
    "fra"
  ]
}