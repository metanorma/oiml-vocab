  "tags": [],
  "localizations": {
    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "repeatability error",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "difference between the highest and lowest results of successive measurements of the same load carried out under the same (or reasonably constant) conditions of measurement [VIM 3.6]"
        }
      ],
      "notes": [
        {
          "content": "Repeatability conditions include:"
        },
        {
          "content": "the same measurement procedure;"
        },
        {
          "content": "the same operator;"
        },
        {
          "content": "the same measuring instrument, used under the same conditions;"
        },
        {
          "content": "the same location;"
        },
        {
          "content": "repetition over a short period of time."
        }
      ],
      "examples": []
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "erreur de répétabilité",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "différence entre le résultat le plus élevé et le résultat le moins élevé de mesures successives réalisées pour une même charge dans des conditions de mesurage identiques (ou raisonnablement constantes) [VIM 3.6]"
        }
      ],
      "notes": [
        {
          "content": "Les conditions de répétabilité incluent :"
        },
        {
          "content": "la même procédure de mesure ;"
        },
        {
          "content": "le même opérateur ;"
        },
        {
          "content": "le même instrument de mesure utilisé dans les mêmes conditions ;"
        },
        {
          "content": "le même lieu ;"
        },
        {
          "content": "la répétition des mesurages pendant une courte période de temps."
        }
      ],
      "examples": []
    }
  },
  "languages": [
    "eng",
    "fra"
  ]
}