  "designations": {
    "eng": "Ancillary device",
    "fra": "Dispositif complémentaire"
  },
  "eng": "Ancillary device",
  "groups": [
    "r-139"
  ],
  "tags": [],
  "localizations": {
    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "Ancillary device",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "Device intended to perform a particular function, directly involved in elaborating, transmitting or displaying measurement results. Main ancillary devices are:"
        },
        {
          "content": "- zero setting device;"
        },
        {
          "content": "- repeating indicating device;"
        },
        {
          "content": "- printing device;"
        },
        {
          "content": "- memory device;"
        },
        {
          "content": "- price indicating device;"
        },
        {
          "content": "- totalizing indicating device;"
        },
        {
          "content": "- pre-setting device;"
        },
        {
          "content": "- self-service device."
        }
      ],
      "notes": [
        {
          "content": "An ancillary device may or may not be subject to legal metrology control according to its function in the measuring system or to national regulations."
        }
      ],
      "examples": []
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "Dispositif complémentaire",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "Dispositif destiné à accomplir une fonction particulière directement impliquée dans l'élaboration, la transmission ou l'affichage de résultats de mesurage. Les principaux dispositifs complémentaires sont :"
        },
        {
          "content": "- dispositif de remise à zéro,"
        },
        {
          "content": "- dispositif indicateur répétiteur,"
        },
        {
          "content": "- dispositif d'impression,"
        },
        {
          "content": "- dispositif de mémorisation,"
        },
        {
          "content": "- dispositif indicateur de prix,"
        },
        {
          "content": "- dispositif totalisateur,"
        },
        {
          "content": "- dispositif prédéterminateur,"
        },
        {
          "content": "- dispositif de libre-service."
        }
      ],
      "notes": [
        {
          "content": "Un dispositif complémentaire peut être soumis ou non aux contrôles de métrologie légale suivant son rôle dans l'ensemble de mesurage ou suivant les réglementations nationales."
        }
      ],
      "examples": []
    }
  },
  "languages": [
    "eng",
    "fra"
  ]
}