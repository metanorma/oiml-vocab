  "localizations": {
    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "recording (measuring) instrument",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "measuring instrument that provides a record of the indication"
        }
      ],
      "notes": [
        {
          "content": "The record (display) may be *analogue* (continuous or discontinuous line) or *digital*."
        },
        {
          "content": "Values of more than one quantity may be recorded (displayed) simultaneously."
        },
        {
          "content": "A recording instrument may also display an indication."
        }
      ],
      "examples": [
        {
          "content": "barograph;"
        },
        {
          "content": "thermoluminescent dosimeter;"
        },
        {
          "content": "recording spectrometer."
        }
      ]
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "appareil (de mesure) enregistreur",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "appareil de mesure qui fournit un enregistrement de l'indication"
        }
      ],
      "notes": [
        {
          "content": "L'enregistrement (affichage) peut être *analogique* (ligne continue ou discontinue) ou *numérique*."
        },
        {
          "content": "Les valeurs de plusieurs grandeurs peuvent être enregistrées (affichées) simultanément."
        },
        {
          "content": "Un appareil enregistreur peut aussi afficher une indication."
        }
      ],
      "examples": [
        {
          "content": "barographe;"
        },
        {
          "content": "dosimètre thermoluminescent;"
        },
        {
          "content": "spectromètre enregistreur."
        }
      ]
    }
  },
