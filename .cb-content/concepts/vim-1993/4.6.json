  "localizations": {
    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "displaying (measuring) instrument",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "measuring instrument that displays an indication"
        }
      ],
      "notes": [
        {
          "content": "The display may be *analogue* (continuous or discontinuous) or *digital*."
        },
        {
          "content": "Values of more than one quantity may be displayed simultaneously."
        },
        {
          "content": "A displaying measuring instrument may also provide a record."
        }
      ],
      "examples": [
        {
          "content": "analogue indicating voltmeter;"
        },
        {
          "content": "digital frequency meter;"
        },
        {
          "content": "micrometer."
        }
      ]
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "appareil (de mesure) afficheur",
          "normativeStatus": "preferred"
        },
        {
          "designation": "appareil (de mesure) indicateur",
          "normativeStatus": "admitted"
        }
      ],
      "definitions": [
        {
          "content": "appareil de mesure qui affiche une indication"
        }
      ],
      "notes": [
        {
          "content": "L'indication peut être *analogique* (continue ou discontinue) ou *numérique*."
        },
        {
          "content": "Les valeurs de plusieurs grandeurs peuvent être indiquées simultanément."
        },
        {
          "content": "Un appareil de mesure afficheur peut, de plus, fournir un enregistrement."
        }
      ],
      "examples": [
        {
          "content": "voltmètre à indication analogique;"
        },
        {
          "content": "fréquencemètre numérique;"
        },
        {
          "content": "micromètre à vis."
        }
      ]
    }
  },
