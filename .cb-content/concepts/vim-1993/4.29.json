    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "gauging (of a measuring instrument)",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "operation of fixing the positions of the scale marks of a measuring instrument (in some cases of certain principal marks only), in relation to the corresponding values of the measurands"
        }
      ],
      "notes": [
        {
          "content": "(Applicable only to the French text.)"
        }
      ],
      "examples": []
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "calibrage (d'un instrument de mesure)",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "positionnement matériel de chaque repère (éventuellement de certains repères principaux seulement) d'un instrument de mesure en fonction de la valeur correspondante du mesurande"
        }
      ],
      "notes": [
        {
          "content": "Ne pas confondre «calibrage» et «étalonnage»."
        }
      ],
      "examples": []
    }
  },
