  ],
  "tags": [],
  "localizations": {
    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "material measure",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "device intended to reproduce or supply, in a permanent manner during its use, one or more known values of a given quantity"
        }
      ],
      "notes": [
        {
          "content": "The quantity concerned may be called the *supplied quantity*."
        }
      ],
      "examples": [
        {
          "content": "a weight;"
        },
        {
          "content": "a measure of volume (of one or several values, with or without a scale);"
        },
        {
          "content": "a standard electrical resistor;"
        },
        {
          "content": "a gauge block;"
        },
        {
          "content": "a standard signal generator;"
        },
        {
          "content": "a reference material."
        }
      ]
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "mesure matérialisée",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "dispositif destiné à reproduire ou à fournir, d'une façon permanente pendant son emploi, une ou plusieurs valeurs connues d'une grandeur donnée"
        }
      ],
      "notes": [
        {
          "content": "La grandeur concernée peut être appelée la *grandeur fournie*."
        }
      ],
      "examples": [
        {
          "content": "masse marquée;"
        },
        {
          "content": "mesure de capacité (à une ou plusieurs valeurs, avec ou sans échelle);"
        },
        {
          "content": "résistance électrique étalon;"
        },
        {
          "content": "cale étalon;"
        },
        {
          "content": "générateur de signaux étalon;"
        },
        {
          "content": "matériau de référence."
        }
      ]
    }
  },
  "languages": [
    "eng",
    "fra"
  ]
}