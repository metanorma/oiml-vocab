          "designation": "nombre d'échelons de vérification",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "rapport entre la portée maximale d'une balance « Max » et l'échelon de vérification « e » : stem:[n = \"Max\" / e]"
        }
      ],
      "notes": [
        {
          "content": "Cette définition concerne les instruments de pesage."
        },
        {
          "content": "« Max » et « e » sont exprimés dans la même unité."
        }
      ],
