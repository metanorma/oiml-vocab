      "definitions": [
        {
          "content": "quotient of the maximum capacity of a balance, \"Max\" and the verification scale interval, stem:[e]: stem:[n = \"Max\" / e]"
        }
      ],
      "notes": [
        {
          "content": "This term applies to weighing instruments."
        },
        {
          "content": "\"Max\" and \"e\" have to be in the same unit."
        }
      ],
