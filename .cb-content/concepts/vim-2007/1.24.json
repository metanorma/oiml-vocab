  "conceptId": "1.24",
  "uri": "https://oimlsmart.github.io/vocab/vim-2007/concept/1.24",
  "status": "valid",
  "designations": {
    "eng": "conversion factor between units",
    "fra": "facteur de conversion entre unités"
  },
  "eng": "conversion factor between units",
  "groups": [
    "1"
  ],
  "tags": [],
  "localizations": {
    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "conversion factor between units",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "ratio of two *measurement units* for *quantities* of the same *kind*"
        }
      ],
      "notes": [
        {
          "content": "The measurement units may belong to different *systems of units*."
        }
      ],
      "examples": [
        {
          "content": "stem:[\"unitsml(km/m)\" = 1000] and thus stem:[1 \"unitsml(km)\" = 1000 \"unitsml(m)\"]"
        }
      ]
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "facteur de conversion entre unités",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "rapport de deux *unités de mesure* correspondant à des *grandeurs* de même *nature*"
        }
      ],
      "notes": [
        {
          "content": "Les unités de mesure peuvent appartenir à des *systèmes d'unités* différents."
        }
      ],
      "examples": [
        {
          "content": "stem:[\"unitsml(km/m)\" = 1000] et par conséquent stem:[1 \"unitsml(km)\" = 1000 \"unitsml(m)\"]"
        },
        {
          "content": "stem:[\"unitsml(h/s)\" = 3600] et par conséquent stem:[1 \"unitsml(h)\" = 3600 \"unitsml(s)\"]"
        },
        {
          "content": "stem:[(\"unitsml(km/h)\")/(\"unitsml(m/s)\") = (1/3.6)] et par conséquent stem:[1 \"unitsml(km/h)\" = (1/3.6) \"unitsml(m/s)\"]"
        }
      ]
    }
  },
  "languages": [
    "eng",
    "fra"
  ]
}