    "eng": {
      "languageCode": "eng",
      "terms": [
        {
          "designation": "sensitivity",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "The change in the response of a measuring instrument divided by the corresponding change in the stimulus."
        }
      ],
      "notes": [
        {
          "content": "Sensitivity may depend on the value of the stimulus."
        }
      ],
      "examples": []
    },
    "fra": {
      "languageCode": "fra",
      "terms": [
        {
          "designation": "sensibilité",
          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "Quotient de l'accroissement de la réponse d'un instrument de mesure par l'accroissement correspondant du signal d'entrée."
        }
      ],
      "notes": [
        {
          "content": "La sensibilité peut dépendre de la valeur du signal d'entrée."
        }
      ],
      "examples": []
    }
