      ],
      "definitions": [
        {
          "content": "A material measure, measuring instrument or system intended to define, realize, conserve or reproduce a unit or one or more known values of a quantity in order to transmit them to other measuring instruments by comparison."
        }
      ],
      "notes": [],
      "examples": [
        {
          "content": "a) 1 kg mass standard;"
        },
        {
          "content": "b) standard gauge block;"
        },
        {
          "content": "c) stem:[100 Omega] standard resistor;"
        },
        {
          "content": "d) saturated Weston standard cell;"
        },
        {
          "content": "e) standard ammeter;"
        },
        {
          "content": "f) caesium atomic frequency standard."
        }
      ]
    },
    "fra": {
      "languageCode": "fra",
