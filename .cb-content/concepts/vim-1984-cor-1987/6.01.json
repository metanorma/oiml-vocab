          "normativeStatus": "preferred"
        }
      ],
      "definitions": [
        {
          "content": "Mesure matérialisée, appareil de mesure ou système de mesure destiné à définir, réaliser, conserver ou reproduire une unité ou une ou plusieurs valeurs connues d'une grandeur pour les transmettre par comparaison à d'autres instruments de mesure."
        }
      ],
      "notes": [],
      "examples": [
        {
          "content": "a) étalon de masse de 1 kg;"
        },
        {
          "content": "b) cale étalon;"
        },
        {
          "content": "c) résistance étalon de stem:[100 Omega];"
        },
        {
          "content": "d) pile étalon saturée de Weston;"
        },
        {
          "content": "e) ampèremètre étalon;"
